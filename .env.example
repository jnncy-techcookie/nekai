# NEKAI Docker settings. Copy to .env and fill in:  cp .env.example .env
# Never commit .env (it's in .gitignore). In Jenkins, the real .env is stored as a Secret file credential.
# Format: one NAME=value per line, no quotes or spaces around "=". Lines starting with # are ignored.

# ---------- Image tag ----------
# Jenkins sets this to the build number. Leave it unset for local use (images are tagged "latest").
# To roll back, set it to an earlier build:  TAG=12 docker compose up -d --no-build
# TAG=

# ---------- Public port ----------
# The reverse proxy is the only published port: open http://localhost:<HTTP_PORT>
HTTP_PORT=8080

# ---------- Database (PostgreSQL) ----------
# DB_USER and DB_PASSWORD are required. Choose your own password.
# The schema is created the first time the database starts with an empty volume, using these values:
# changing the password here later does NOT change it inside an existing database.
DB_USER=nekai
DB_PASSWORD=change-me
DB_NAME=nekai

# ---------- Gemini (AI features) ----------
# Get a free key at https://aistudio.google.com/apikey
# Without it the app still works: Neko says it isn't set up, and Discover shows curated picks.
GEMINI_API_KEY=gemini-api-key-here
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# ---------- Email (password reset links) ----------
# The address people open NEKAI at (used in the emailed link)
APP_URL=http://localhost:8080
# Optional SMTP server. Without SMTP_HOST, reset emails are printed in the api container's log:
#   docker compose logs api
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=NEKAI <no-reply@nekai.local>
