# NEKAI backend settings
# Copy this file to backend/.env and fill in your own values:
#   cp backend/.env.example backend/.env
# server.js loads backend/.env on startup. Real environment variables win over this file.
# Never commit backend/.env: it holds your secret keys (it's in .gitignore).
# Format: one NAME=value per line, no quotes or spaces around "=". Lines starting with # are ignored.

# ---------- Gemini (AI features) ----------
# Google Gemini API key, used by Neko (/api/neko/chat) and Nekai's Picks (/api/recommend).
# Get a free key at https://aistudio.google.com/apikey
# Without it the rest of the app still works: Neko says it isn't set up, and Discover shows curated picks.
GEMINI_API_KEY=gemini-api-key-here

# Optional: Gemini models. Each request tries the main model twice, then the fallback twice.
# The fallback also takes over when the main model's free quota runs out (HTTP 429).
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# ---------- Supabase (accounts and data) ----------
# Both values are in the Supabase dashboard: Project Settings → API keys (the URL is also under Data API).
# Sign-in and each user's data go straight from the browser to Supabase, using the publishable key
# set in frontend/js/core/supabase.js. The server only needs these two for:
#   - saving anime details from Tenrai into the shared anime_catalog table
#   - deleting accounts (DELETE /api/account)
# Without them the server still runs and logs a warning; those two features are off.
SUPABASE_URL=https://project-ref.supabase.co

# The SECRET key (sb_secret_…), not the publishable one. It bypasses row level security,
# so it must stay on the server: never put it in frontend code or commit it.
# Older projects call it the service_role key; SUPABASE_SERVICE_ROLE_KEY works too.
# Left empty here on purpose: an empty key triggers the server's clear "missing" warning.
SUPABASE_SECRET_KEY=

# ---------- Server ----------
# Optional: port the server listens on (open http://localhost:<PORT>)
# PORT=3000
