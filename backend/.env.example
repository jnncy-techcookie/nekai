# Nekai backend settings. Copy this file to backend/.env and fill it in.
# backend/.env is gitignored: never commit real keys.
# Format: NAME=value (no spaces around =, no quotes needed)

# Required for Lolli (the chat assistant). Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: which Gemini models Lolli uses (these are the defaults)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Optional: port for the server (default 3000)
# PORT=3000

# Supabase (Project Settings -> API keys)
SUPABASE_URL=https://your-project.supabase.co
# The secret key bypasses row level security. It fills anime_catalog and deletes
# accounts, so it stays here on the server only, never in frontend code.
SUPABASE_SECRET_KEY=
