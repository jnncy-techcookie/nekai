# NEKAI backend settings
# Copy this file to backend/.env and fill in your own values:
#   cp backend/.env.example backend/.env
# server.js loads backend/.env on startup. Real environment variables win over this file.
# Never commit backend/.env: it holds your secret keys (it's in .gitignore).
# Format: one NAME=value per line, no quotes or spaces around "=". Lines starting with # are ignored.

# ---------- Gemini (AI features) ----------
# Google Gemini API key, used by Neko (/api/neko/chat) and Nekai's Picks (/api/recommend).
# Get a free key at https://aistudio.google.com/apikey
# Without it the rest of the app still works: Neko says it isn't set up, and Discover shows curated picks.
GEMINI_API_KEY=gemini-api-key-here

# Optional: Gemini models. Each request tries the main model twice, then the fallback twice.
# The fallback also takes over when the main model's free quota runs out (HTTP 429).
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# ---------- PostgreSQL (accounts and data) ----------
# Every account, list, history, setting and Neko chat lives here (schema: db/init.sql).
# The app needs a running database: in Docker, the db service; on a laptop, any PostgreSQL 16, e.g.
#   docker run -d --name nekai-db -e POSTGRES_USER=nekai -e POSTGRES_PASSWORD=change-me #     -e POSTGRES_DB=nekai -p 5432:5432 -v nekai-pg-data:/var/lib/postgresql/data #     -v "$PWD/db/init.sql:/docker-entrypoint-initdb.d/init.sql:ro" postgres:16-alpine
DATABASE_URL=postgresql://nekai:change-me@localhost:5432/nekai

# ---------- Email (password reset links) ----------
# The address used in emailed links. Set it to the address people open NEKAI at.
# APP_URL=http://localhost:3000
# Optional SMTP server. Without SMTP_HOST, reset emails are printed to the server log instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=NEKAI <no-reply@nekai.local>

# ---------- Server ----------
# Optional: port the server listens on (open http://localhost:<PORT>)
# PORT=3000
# Optional: where uploaded profile pictures are stored (in Docker: a named volume)
# UPLOAD_DIR=./uploads
