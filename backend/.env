# Nekai backend settings. Loaded by backend/src/server.js on startup.
# Format: NAME=value (no spaces around =, no quotes needed)

# Required for Lolli (the chat assistant). Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6JcsHBJYaaiHGKmaZDhIVliHGfJmuDBBRoCSWOL0U_ucQ

# Optional: which Gemini models Lolli uses (these are the defaults)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Optional: port for the server (default 3000)
# PORT=3000
