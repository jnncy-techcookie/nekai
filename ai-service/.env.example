# NEKAI AI service settings
# Copy this file to ai-service/.env and fill in your own values.
# server.js loads ai-service/.env on startup. Real environment variables win over this file.
# Never commit ai-service/.env: it holds your secret key (it's in .gitignore).

# Google Gemini API key, used by Neko (/api/neko/chat) and Nekai's Picks (/api/recommend).
# Get a free key at https://aistudio.google.com/apikey
# Without it the rest of the app still works: Neko says it isn't set up, and Discover shows curated picks.
GEMINI_API_KEY=gemini-api-key-here

# Optional: Gemini models. Each request tries the main model twice, then the fallback twice.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Where the api service lives (sessions and anime lookups go through it).
# On a laptop: http://localhost:3000. In Docker Compose: http://api:3000.
API_URL=http://localhost:3000

# Optional: port this service listens on
# PORT=3001
