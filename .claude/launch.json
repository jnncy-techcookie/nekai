{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nekai",
      "runtimeExecutable": "node",
      "runtimeArgs": ["dev/gateway.js"],
      "port": 8080
    },
    {
      "name": "nekai-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "api", "start"],
      "env": { "NODE_OPTIONS": "--use-system-ca" },
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "nekai-ai-service",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "ai-service", "start"],
      "env": { "NODE_OPTIONS": "--use-system-ca" },
      "port": 3001,
      "autoPort": true
    }
  ]
}
